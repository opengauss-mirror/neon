# Neon Docker 一键部署配置

OG_VERSION="V702"
COMPOSE_PROJECT_NAME="neon_poc"
SKIP_PULL="false"

NUM_PAGESERVERS="1"
NUM_SAFEKEEPERS="1"

# must-not-exist：已有 .neon 时拒绝覆盖
# remove-all-contents：重新初始化并删除已有状态
INIT_FORCE="must-not-exist"
INIT_TIMEOUT="120"
HEALTH_CHECK_TIMEOUT="120"

CREATE_DEFAULT_TENANT="true"
CREATE_DEFAULT_ENDPOINT="true"

DEFAULT_ENDPOINT_NAME="main"
DEFAULT_BRANCH_NAME="main"
DEFAULT_ENDPOINT_PG_PORT="55433"
DEFAULT_ENDPOINT_HTTP_PORT="3080"

DOCKER_CONTROL_PLANE_HOST_PORT="8080"
STORAGE_CONTROLLER_HOST_PORT="1234"

# 远端存储模式：localfs 保持原有本地部署；s3 启用S3兼容对象存储。
REMOTE_STORAGE_MODE="localfs"

# REMOTE_STORAGE_MODE=s3 时生效。Bucket需要提前创建。
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="us-east-1"
PAGESERVER_S3_PREFIX="opengauss-neon/pageserver"
SAFEKEEPER_S3_PREFIX="opengauss-neon/safekeeper"
S3_CONCURRENCY_LIMIT="20"

# 相对路径按部署目录解析。仅S3模式要求该文件存在。
OBJECT_STORAGE_CREDENTIALS_FILE="./object_storage.env"
