# Kubernetes Namespace，部署资源都会创建在此 Namespace 中
NAMESPACE=branch
# 节点本地数据目录，默认使用 deploy_k8s 目录下的 .neon
DATA_ROOT=.neon
# 存储组件使用的容器镜像
STORAGE_IMAGE=
# 计算组件使用的容器镜像
COMPUTE_IMAGE=
# 镜像内 openGauss 安装目录的版本名称
OG_VERSION=V702
# 运行工作负载的 Kubernetes 节点名称
NODE_NAME=
# 控制面初始化时使用的 Compose 项目名称 通过kubectl get nodes查看
COMPOSE_PROJECT=branch
# 初始化时注册的 Safekeeper 数量
NUM_SAFEKEEPERS=1
# 是否等待 Deployment、Job 和资源池就绪
WAIT=true
# 是否保留已完成的一次性 Job
KEEP_JOBS=false

# 分支协调器与计算重绑接口分别使用独立令牌认证
# 令牌路径相对于 deploy_k8s 目录；部署脚本自动从集群 Secret 生成或同步，请勿提交令牌内容
COORDINATOR_TOKEN_FILE=.coordinator/coordinator-token
# 分支协调器 HTTP 地址；部署脚本自动回填本集群 Service 的 ClusterIP 和 8787 端口
# 部署前留空；资源池创建、删除和 PITR 必须配置协调器地址；部署后自动回填
COORDINATOR_URL=
