-- ============================================================================
-- STEP 2: Create a new branch using shell command
-- ============================================================================
-- Create the branch using full path (neon_root is set by the wrapper)
\! neon_local timeline branch --branch-name branch1
Syncing branch point with endpoint flush LSN: X/XXXXXXXX
Waiting for pageserver to sync WAL to X/XXXXXXXX...
(This may take a while for large transactions)
WAL sync complete.
Created timeline 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' at Lsn X/XXXXXXXX for tenant: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx. Ancestor timeline: 'main'
-- Create and start endpoint for the branch
-- Use $BRANCH1_PORT environment variable (exported by wrapper) to match :branch1_port
\! neon_local endpoint create ep_branch1 --branch-name branch1 --pg-port ${BRANCH1_PORT}
\! neon_local endpoint start ep_branch1
Starting existing endpoint ep_branch1...
Starting postgres node at 'postgresql://cloud_admin@127.0.0.1:xxxxx/postgres'
-- ============================================================================
-- STEP 3: Switch to new branch and check main branch data
-- ============================================================================
-- Switch to branch endpoint (port xxxxx = branch1_port)
\c - - - :branch1_port
You are now connected to database "postgres" as user "cloud_admin" on host "127.0.0.1" at port "xxxxx".
SELECT * FROM test_branch;
 id | name  | value |         created_at
----+-------+-------+----------------------------
