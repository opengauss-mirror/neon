-- Test Case 70: Trigger Inheritance
-- ============================================================================
-- Step 1: Create table with trigger on MAIN
CREATE TABLE test_trigger_70 (
    id SERIAL PRIMARY KEY,
    value INTEGER,
    last_updated TIMESTAMP
);
gsql:NEON_ROOT/sql/neon_db_objects_test.sql:268: NOTICE:  CREATE TABLE will create implicit sequence "test_trigger_70_id_seq" for serial column "test_trigger_70.id"
gsql:NEON_ROOT/sql/neon_db_objects_test.sql:268: NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "test_trigger_70_pkey" for table "test_trigger_70"
CREATE TABLE
CREATE OR REPLACE FUNCTION update_timestamp()
RETURNS TRIGGER AS $$
BEGIN
    NEW.last_updated = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;
CREATE FUNCTION
CREATE TRIGGER trg_update_timestamp
BEFORE INSERT OR UPDATE ON test_trigger_70
FOR EACH ROW EXECUTE FUNCTION update_timestamp();
CREATE TRIGGER
INSERT INTO test_trigger_70 (value) VALUES (100);
INSERT 0 1
