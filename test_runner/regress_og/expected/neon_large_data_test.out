\! neon_local endpoint create ep_test_78 --branch-name test_branch_78 --pg-port ${BRANCH1_PORT}
\! neon_local endpoint start ep_test_78
Starting existing endpoint ep_test_78...
Starting postgres node at 'postgresql://cloud_admin@127.0.0.1:55435/postgres'
-- Step 3: Perform updates on branch
\c - - - :branch1_port
You are now connected to database "postgres" as user "cloud_admin" on host "127.0.0.1" at port "55435".
-- Update counters on branch
UPDATE test_update_78 
SET counter = counter + 1, updated_at = CURRENT_TIMESTAMP
WHERE status = 'active';
UPDATE 5000
SELECT 'BRANCH - After update:' AS checkpoint;
       checkpoint       
------------------------
 BRANCH - After update:
(1 row)

SELECT status, COUNT(*) AS count, AVG(counter) AS avg_counter
FROM test_update_78
GROUP BY status
ORDER BY status;
  status  | count |      avg_counter       
----------+-------+------------------------
 active   |  5000 | 1.00000000000000000000
 inactive |  5000 | 0.00000000000000000000
(2 rows)

-- Step 4: Verify MAIN unchanged
\c - - - :main_port
You are now connected to database "postgres" as user "cloud_admin" on host "127.0.0.1" at port "55432".
