-- ============================================================================
-- Test Case 78: Large Data Update Performance
-- ============================================================================
-- Step 1: Create table on MAIN
CREATE TABLE test_update_78 (
    id SERIAL PRIMARY KEY,
    status VARCHAR(20),
    counter INTEGER DEFAULT 0,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
gsql:NEON_ROOT/sql/neon_large_data_test.sql:159: NOTICE:  CREATE TABLE will create implicit sequence "test_update_78_id_seq" for serial column "test_update_78.id"
gsql:NEON_ROOT/sql/neon_large_data_test.sql:159: NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "test_update_78_pkey" for table "test_update_78"
CREATE TABLE
-- Insert 10,000 rows
INSERT INTO test_update_78 (status, counter)
SELECT 
    CASE WHEN i % 2 = 0 THEN 'active' ELSE 'inactive' END,
    0
FROM generate_series(1, 10000) AS i;
INSERT 0 10000
-- Verify initial state
SELECT 'MAIN branch - Initial status distribution:' AS checkpoint;
                 checkpoint                 
--------------------------------------------
 MAIN branch - Initial status distribution:
(1 row)

SELECT status, COUNT(*) AS count, AVG(counter) AS avg_counter
FROM test_update_78
GROUP BY status
ORDER BY status;
  status  | count |      avg_counter       
----------+-------+------------------------
 active   |  5000 | 0.00000000000000000000
 inactive |  5000 | 0.00000000000000000000
(2 rows)

-- Step 2: Create branch
\! neon_local timeline branch --branch-name test_branch_78 --ancestor-branch-name main
Syncing branch point with endpoint flush LSN: 0/3513210
Waiting for pageserver to sync WAL to 0/3513210...
(This may take a while for large transactions)
WAL sync complete.
