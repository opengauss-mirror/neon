-- ============================================================================
-- Large Data Volume Test
-- ============================================================================
-- Description: Test large data volume operations with branching
-- Tests data inheritance, isolation, and performance with large datasets
-- ============================================================================
-- ============================================================================
-- Test Case 76: Large Table Data Inheritance
-- ============================================================================
-- Step 1: Create large table on MAIN
CREATE TABLE test_large_76 (
    id SERIAL PRIMARY KEY,
    data TEXT,
    value INTEGER,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
gsql:NEON_ROOT/sql/neon_large_data_test.sql:18: NOTICE:  CREATE TABLE will create implicit sequence "test_large_76_id_seq" for serial column "test_large_76.id"
gsql:NEON_ROOT/sql/neon_large_data_test.sql:18: NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "test_large_76_pkey" for table "test_large_76"
CREATE TABLE
-- Insert 10,000 rows
INSERT INTO test_large_76 (data, value)
SELECT 
    'data_' || i::TEXT,
    i
FROM generate_series(1, 10000) AS i;
INSERT 0 10000
-- Verify row count on MAIN
SELECT 'MAIN branch - Row count:' AS checkpoint;
        checkpoint        
--------------------------
 MAIN branch - Row count:
(1 row)

SELECT COUNT(*) AS row_count FROM test_large_76;
 row_count 
-----------
     10000
(1 row)

-- Verify data sample
SELECT 'MAIN branch - Data sample:' AS checkpoint;
         checkpoint         
----------------------------
 MAIN branch - Data sample:
(1 row)

SELECT id, data, value 
FROM test_large_76 
WHERE id IN (1, 5000, 10000)
ORDER BY id;
  id   |    data    | value 
-------+------------+-------
     1 | data_1     |     1
  5000 | data_5000  |  5000
 10000 | data_10000 | 10000
(3 rows)

-- Step 2: Create branch
\! neon_local timeline branch --branch-name test_branch_76 --ancestor-branch-name main
